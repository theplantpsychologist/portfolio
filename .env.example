# Copy to .env (gitignored) and fill in. Used by `npm run publish`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portfolio-media

# Used by the site build. Set these in Cloudflare Pages too.
# Leave PUBLIC_MEDIA_BASE empty locally to serve processed media from .media-out/.
PUBLIC_MEDIA_BASE=
SITE_URL=https://example.com
PUBLIC_CF_BEACON_TOKEN=
