---
import type { Picture } from "../lib/media";

interface Props {
  pic: Picture | null;
  alt: string;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { pic, alt, sizes, eager = false, class: cls } = Astro.props;
---
{pic ? (
  <img
    class={cls}
    src={pic.src}
    srcset={pic.srcset}
    sizes={sizes}
    width={pic.width}
    height={pic.height}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
    style={`background-color:${pic.color}`}
  />
) : (
  <div class:list={[cls, "missing"]} role="img" aria-label={alt}></div>
)}
