# Secrets for the contact function when testing with `npm run preview:functions`.
# Copy to .dev.vars (gitignored). In production, set these in Cloudflare Pages.
# These Turnstile values are Cloudflare's always-pass test keys.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=
CONTACT_TO=theplantpsychologist@gmail.com
CONTACT_FROM=Portfolio <contact@yourdomain.com>
